# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Both are safe in the browser; the database's security rules decide access.
# Never put the service (secret) key in a VITE_ variable: it would be built
# into the website for anyone to read.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
