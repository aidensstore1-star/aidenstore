# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Both are safe in the browser; the database's security rules decide access.
# Never put the service (secret) key in a VITE_ variable: it would be built
# into the website for anyone to read.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Only for `npm run db:upload-photos`, run once on your own computer. Keep it
# out of Cloudflare's build settings and never give it a VITE_ prefix.
# SUPABASE_SERVICE_KEY=

# The site's address, for the sitemap, canonical links and share previews.
# SITE_URL=https://example.com/
